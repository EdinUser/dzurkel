#!/usr/bin/make -f

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=ON -DCMAKE_INSTALL_PREFIX=/usr

override_dh_auto_test:
	QT_QPA_PLATFORM=offscreen dh_auto_test -- ARGS=--output-on-failure

override_dh_auto_install:
	dh_auto_install
	desktop-file-validate debian/dzurkel/usr/share/applications/*.desktop
