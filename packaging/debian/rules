#!/usr/bin/make -f

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=ON -DCMAKE_INSTALL_PREFIX=/usr -DDZURKEL_HIGHLIGHTING=ON -DDZURKEL_AUDIO=ON

# Optional adapters carry their own backend dependencies.
override_dh_shlibdeps:
	dh_shlibdeps -Xlibdzurkel_highlighting.so -Xlibdzurkel_audio.so -Xlibdzurkel_desktop.so -Xlibdzurkel_chooser.so

override_dh_auto_test:
	QT_QPA_PLATFORM=offscreen dh_auto_test -- ARGS=--output-on-failure

override_dh_auto_install:
	dh_auto_install
	desktop-file-validate debian/dzurkel/usr/share/applications/*.desktop
