[Desktop Entry]
Type=Service
Name=Dzurkel
Icon=dzurkel
StartupNotify=true
MimeType=application/octet-stream;inode/directory;
Actions=dzurkel;
X-KDE-Protocols=file,smb,sftp
X-KDE-RequiredNumberOfUrls=1
X-KDE-Priority=TopLevel

[Desktop Action dzurkel]
Name=Dzurkel
Icon=dzurkel
Exec="@DZURKEL_EXEC@" --show -- %u
